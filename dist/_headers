# Header ความปลอดภัย — Cloudflare Pages และ Netlify อ่านไฟล์นี้อัตโนมัติ (สร้างโดย build-single.mjs ห้ามแก้ตรง ๆ)
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-XKldTrvNHsBkKd4zBgWsgq0j2UIlNOgdCva5EhenFnA=' 'sha256-bjNbvI8tl8y+bAasiIIyVXON/+FsTDSS9qAipExqFpE=' 'sha256-Hn7GQqdNixzI78BdyFzK+WR0oDXcEhZYu6zS914Zyvs=' 'sha256-vA/P2cIo3O2c+k59otL3qQKsSddm7z+5w6UAijUkoq8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com http://localhost:* http://127.0.0.1:*; base-uri 'none'; form-action 'none'; object-src 'none'; manifest-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), interest-cohort=()

# หน้าหลักต้องตรวจเวอร์ชันใหม่ทุกครั้ง เพื่อให้การอัปเดตถึงผู้ใช้ทันที (ไม่ต้องกด Ctrl+F5)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# ไฟล์ SDK มีเลขเวอร์ชันในชื่อ เก็บแคชได้นาน
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
